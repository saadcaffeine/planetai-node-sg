# Delhi, India. ./install.sh --preset delhi --name <yours>
# Reference for "outside" is the CAMS model; India has no key-free aggregator equivalent to Bali's.
# For measured stations here, OpenAQ carries CPCB data but needs a free API key. See docs/PREFILL.md.
NODE_CITY=delhi
NODE_LAT=28.6139
NODE_LON=77.2090
NODE_TZ=Asia/Kolkata
ALERT_LOCALE=en
CKAN_PORTALS=
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first.
NODE_ISSUES=air,heat

#!/usr/bin/env bash
# Installed by `cp tools/hooks/pre-commit .git/hooks/`. Blocks the three things that have actually gone wrong on this project.
# Every check must FAIL LOUDLY if it cannot run — a security check that errors silently is worse than none.
set -euo pipefail
# Hooks fired from a GUI (GitHub Desktop, an IDE, a Cowork session) inherit no shell profile; without brew's
# prefix the tools `make lint`/`make test` reach for are simply not on PATH. Found as working-tree drift in
# the Oct 10 audit and adopted deliberately — the drift's other half (commenting out the make test gate) was
# refused: a hook that skips the suite teaches people to reach for --no-verify. APPENDED, not prepended:
# prepending shadowed an activated venv's python with homebrew's (no sqlglot, no psycopg) and make test
# failed inside the hook while passing in the shell (v0.80.7's docs commit, 10 Oct).
export PATH="$PATH:/opt/homebrew/bin"
fail(){ printf '\033[1;31mpre-commit: %s\033[0m\n' "$*" >&2; exit 1; }

staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
[[ -z "$staged" ]] && exit 0

# 1. files that must never be committed
grep -qx '.env'                  <<<"$staged" && fail ".env holds your bot token and db password"
grep -q  '^\.git/'               <<<"$staged" && fail ".git contents staged"
grep -qE '^backups/|\.before-update$' <<<"$staged" && fail "backups or *.before-update staged"

# 2. a live credential inside a diff. Telegram puts the token in the URL path, so a pasted log leaks it.
diff="$(git diff --cached)"
for pat in 'api\.telegram\.org/bot[0-9]{6,}:' '^\+[A-Z_]*TOKEN=[^[:space:]]{12,}' '^\+[A-Z_]*API_KEY=[^[:space:]]{12,}'; do
  if hits="$(grep -nE "$pat" <<<"$diff")"; then
    printf '%s\n' "$hits" | head -3
    fail "a credential appears in this diff"
  fi
done
# password, allowing the placeholder and the throwaway CI one
if hits="$(grep -nE '^\+.*POSTGRES_PASSWORD=' <<<"$diff" | grep -vE 'change-me|POSTGRES_PASSWORD=x ')"; then
  printf '%s\n' "$hits" | head -3
  fail "a database password appears in this diff"
fi

# 2b. Finder litter and caches never get committed
if git diff --cached --name-only --diff-filter=AM | grep -qE '(^|/)\.DS_Store$|__pycache__|\.pyc$'; then    # added/modified only: deleting litter is fine
  echo "pre-commit: .DS_Store / __pycache__ staged. Unstage them: git rm --cached <file>"; exit 1
fi

# 3. the offline gates. Each one corresponds to an outage we already had.
# Both of them. AGENTS.md has said "make lint && make test before any commit" since v0.14 and this hook ran only
# the first, so a commit in the reports release removed a function and left test_shipped.py red — the assertion
# named the artifact correctly and nothing was listening (7 Sep 2026). Neither is slow: lint is a few seconds,
# test is a few more, and both are offline.
# `env -u` because git exports GIT_DIR and GIT_INDEX_FILE to its hooks, and in a WORKTREE that
# GIT_DIR is .git/worktrees/<name> — so a suite that shells out to git reads the wrong repository.
# tests/test_ship_gate.sh does, and failed here every time, on a tree where `make test` run by hand
# passed. The symptom is the worst kind: a gate that is red for a reason that has nothing to do with
# the diff, which teaches people to reach for --no-verify.
gates() { env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX "$@"; }
gates make lint >/dev/null || fail "make lint failed — run 'make lint' to see why"
gates make test >/dev/null || fail "make test failed — run 'make test' to see why"
exit 0
